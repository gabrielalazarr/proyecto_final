# 1. Copia este archivo y renombralo como  .env
# 2. Reemplaza lo de abajo con TU cadena real de MongoDB Atlas.
# 3. NUNCA subas el archivo .env a GitHub: agregalo a .gitignore.
#
# La clave vive solo aqui (en tu maquina), nunca dentro del codigo.

MONGO_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/?appName=Cluster0
GEMINI_API_KEY=tu_clave_de_gemini